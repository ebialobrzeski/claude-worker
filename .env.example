# --- Mode -------------------------------------------------------------------
# queue          — run tasks dropped into tasks/queue (headless, default)
# remote-control — drive Claude from claude.ai/code or the Claude mobile app
# both           — queue worker + Remote Control side by side
WORKER_MODE=queue

# --- Authentication ---------------------------------------------------------
# Queue mode: generate with `claude setup-token`, or leave empty and use the
# stored login from `claude-worker login` (run in the container terminal).
# Remote Control ALWAYS needs that login — setup-token tokens can't open
# Remote Control sessions.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Storage ----------------------------------------------------------------
# By default everything lives in named volumes (works in Dockhand, which runs
# compose from its own data dir). To use folders on the host instead, set
# ABSOLUTE paths — relative ones only work with `docker compose` run from a
# checkout of this repo.
# LOCAL_REPO_PATH=/volume1/projects/my-repo
# TASKS_PATH=/volume1/docker/claude-worker/tasks
# LOGS_PATH=/volume1/docker/claude-worker/logs
# CLAUDE_HOME_PATH=/volume1/docker/claude-worker/claude-home
# SSH_KEY_PATH=/volume1/homes/me/.ssh

# Image: prebuilt on GHCR; falls back to a local build if the pull fails.
# WORKER_IMAGE=ghcr.io/ebialobrzeski/claude-worker:latest
# WORKER_PULL_POLICY=always

# UID/GID to run the worker as — must match your NAS user.
# Run `id` on the NAS host to find the right values.
PUID=1000
PGID=1000

GIT_USER_EMAIL=you@example.com
GIT_USER_NAME=Claude Worker

# Repo to work on: clone into the workspace volume on first start
# (or mount one with LOCAL_REPO_PATH above).
# REPO_URL=https://github.com/youruser/yourrepo.git
# REPO_BRANCH=main
# HTTPS auth for github.com (fine-grained PAT, Contents: read/write).
# GITHUB_TOKEN=

COMMIT_BRANCH_PREFIX=claude/work
GIT_PULL_BEFORE=true
GIT_PUSH=false

CLAUDE_ALLOWED_TOOLS=Bash,Read,Write,Edit,Glob,Grep,LS
CLAUDE_MAX_TURNS=30
POLL_INTERVAL=30

# --- Remote Control (WORKER_MODE=remote-control|both) -----------------------
# Name shown in the session list on claude.ai/code and in the app.
RC_NAME=claude-worker
# same-dir | worktree (each session in its own git worktree — recommended
# with WORKER_MODE=both or RC_CAPACITY>1) | session
RC_SPAWN=same-dir
# Max concurrent sessions.
RC_CAPACITY=4
# default | acceptEdits | plan | bypassPermissions — anything not
# auto-approved is sent to the app for you to approve.
RC_PERMISSION_MODE=acceptEdits
# Extra flags for `claude remote-control`, e.g. --verbose
RC_EXTRA_ARGS=

# --- Docker on the host -----------------------------------------------------
# Uncomment to let Claude use the host's Docker daemon (= root on the host!).
# DOCKER_SOCKET_PATH=/var/run/docker.sock
# Host path of /workspace for bind mounts Claude creates — detected
# automatically; set only to override.
# HOST_WORKSPACE_PATH=

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Accept commands (/task, /status, /log, …) from TELEGRAM_CHAT_ID.
# Needs WORKER_MODE=queue or both.
TELEGRAM_COMMANDS=false
# Comma-separated Telegram user IDs allowed to send commands (recommended
# for group chats). Empty = anyone in TELEGRAM_CHAT_ID.
TELEGRAM_ALLOWED_USER_IDS=
# Treat plain-text messages (without /task) as tasks.
TELEGRAM_PLAIN_TEXT_TASKS=true
